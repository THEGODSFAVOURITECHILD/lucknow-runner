# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - it contains secrets

# Server
PORT=3000
NODE_ENV=development

# Database - paste the full URL from Railway dashboard
# Example: postgresql://postgres:password@host:port/railway
DATABASE_URL=postgresql://YOUR_RAILWAY_DB_URL_HERE

# JWT - make this a long random string (50+ characters)
# Generate one at: https://generate-secret.vercel.app/50
JWT_SECRET=replace_this_with_a_very_long_random_secret_string_here

# Google Sign-In - from Firebase Console > Project Settings > Your Apps
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Razorpay - ADD IN WEEK 4 ONLY
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_here
